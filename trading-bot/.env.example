# =============================================================================
# Mesa de trading (desk) - configuración
# Copia este fichero a .env y ajusta. Ningún valor es obligatorio en modo paper:
# los valores por defecto son prudentes. NUNCA subas tu .env a git.
# =============================================================================

# --- modo y mercado -----------------------------------------------------------
# paper = simulado con precios reales (por defecto) | live = dinero real (ver checklist en README)
DESK_MODE=paper
# hyperliquid (datos públicos reales) | sim (mercado simulado offline) | replay:datos/btc_15m.csv
DESK_DATA=hyperliquid
# Monedas para la operativa automática (los comandos pueden operar cualquier moneda del exchange)
DESK_SYMBOLS=BTC,ETH,SOL,HYPE
# Carpeta de estado, diarios y logs
DESK_STATE_DIR=state

# --- dimensionamiento ("unidades") -------------------------------------------
# notional = unidades x margen por unidad x apalancamiento (recortado al máximo de cada moneda)
DESK_LEVERAGE=5
DESK_UNIT_MARGIN_USD=500
DESK_MAX_UNITS_PER_TRADE=4

# --- riesgo (reglas tipo firma de fondeo) --------------------------------------
# Pérdida máxima si salta el SL, en % del equity (el tamaño se recorta para cumplirlo)
DESK_RISK_PER_TRADE_PCT=1.0
# Nunca abrir sin stop-loss
DESK_REQUIRE_STOP=true
# SL por defecto (% desde la entrada) y TP por defecto (múltiplos R del riesgo)
DESK_DEFAULT_SL_PCT=1.5
DESK_DEFAULT_TP_R=2.0
DESK_MAX_OPEN_POSITIONS=3
DESK_MAX_NOTIONAL_PER_COIN_USD=25000
DESK_MAX_GROSS_NOTIONAL_USD=50000
# Pérdida diaria máxima (día UTC): detiene nuevas entradas hasta el día siguiente
DESK_DAILY_LOSS_LIMIT_PCT=3.0
# Drawdown máximo desde el máximo de equity: cierra todo y detiene hasta "reset halt"
DESK_MAX_DRAWDOWN_PCT=5.0
# true = al tocar la pérdida diaria también cierra todas las posiciones
DESK_FLATTEN_ON_DAILY_LIMIT=false
# Tras N pérdidas seguidas, pausa de la operativa automática durante X minutos
DESK_MAX_CONSECUTIVE_LOSSES=4
DESK_LOSS_COOLDOWN_MINUTES=120
# No entrar si el spread supera estos puntos básicos o los datos tienen más de N segundos
DESK_MAX_SPREAD_BPS=25
DESK_MAX_DATA_AGE_SECONDS=120

# --- ejecución ---------------------------------------------------------------
# Entrada por defecto de los comandos: zone (límite en la zona de liquidez) | market
DESK_DEFAULT_ENTRY_MODE=zone
# Si no hay zona de liquidez clara: skip (no entra y lo explica) | market
DESK_ZONE_FALLBACK=skip
# Minutos que espera una orden límite antes de cancelarse
DESK_ENTRY_TTL_MINUTES=240
# Tolerancia de precio de las órdenes a mercado (IOC), en puntos básicos
DESK_MARKET_SLIPPAGE_BPS=10

# --- zonas de liquidez ---------------------------------------------------------
# Ancho de cada tramo (% del precio) y distancia mínima/máxima al precio actual
DESK_ZONE_WIDTH_PCT=0.11
DESK_ZONE_MAX_DISTANCE_PCT=3.0
DESK_ZONE_MIN_DISTANCE_PCT=0.05
# Peso del libro de órdenes frente a los niveles de liquidación
DESK_ZONE_BOOK_WEIGHT=1.0
DESK_ZONE_LIQ_WEIGHT=2.0

# --- operativa autónoma 24/7 ---------------------------------------------------
# true = opera sola con las estrategias aunque no le des comandos
DESK_AUTO=true
DESK_STRATEGIES=liquidity_sweep,squeeze_breakout
# Unidades por operación automática
DESK_AUTO_UNITS=1
# Segundos entre ciclos, entre evaluaciones de estrategias y entre líneas de estado
DESK_LOOP_SECONDS=10
DESK_STRATEGY_SECONDS=60
DESK_STATUS_EVERY_SECONDS=300

# --- paper (simulación de ejecución) -------------------------------------------
DESK_PAPER_START_EQUITY=10000
DESK_PAPER_TAKER_FEE_BPS=4.5
DESK_PAPER_MAKER_FEE_BPS=1.5
DESK_PAPER_SLIPPAGE_BPS=2.0
DESK_PAPER_MAINTENANCE_MARGIN_PCT=0.5

# --- IA para entender comandos en lenguaje libre (opcional) ----------------------
# Sólo se usa si las reglas no entienden el texto. Las órdenes interpretadas por IA piden "si".
DESK_LLM_ENABLED=true
DESK_LLM_MODEL=claude-opus-5-5
DESK_LLM_CONFIRM_TRADES=true
# Clave de la API de Anthropic (vacía = sin IA; los comandos con reglas funcionan igual)
ANTHROPIC_API_KEY=

# --- live en Hyperliquid (DINERO REAL) -------------------------------------------
# Testnet por defecto incluso en modo live; true = mainnet
DESK_HL_MAINNET=false
# Para operar en live hay que escribir exactamente: I_UNDERSTAND_REAL_MONEY
DESK_LIVE_CONFIRM=
# Clave privada de la wallet que firma (mejor una API wallet sin permisos de retiro)
HL_PRIVATE_KEY=
# Dirección de la cuenta principal si HL_PRIVATE_KEY es de una API wallet (agente)
HL_ACCOUNT_ADDRESS=

# --- datos de liquidaciones (opcional) -------------------------------------------
# Clave de la API de Moon Dev para niveles de liquidación reales (vacía = sólo libro de órdenes)
MOONDEV_API_KEY=

# --- backtest por gráfica y optimización walk-forward -----------------------------
# Días de historia por defecto para "backtest HYPE 1h" (Hyperliquid da como máximo 5000 velas)
DESK_BT_DEFAULT_DAYS=120
# Qué se maximiza fuera de muestra: sharpe | calmar | profit_factor | return
DESK_BT_OBJECTIVE=sharpe
# Tramos walk-forward (entrenar en el pasado, validar en el tramo siguiente)
DESK_BT_FOLDS=4
# Combinaciones de parámetros probadas por estrategia
DESK_BT_MAX_COMBOS=60
# Filtros para aprobar una estrategia (medidos FUERA de muestra)
DESK_BT_MIN_TRADES=20
DESK_BT_MIN_PROFIT_FACTOR=1.15
DESK_BT_MAX_DRAWDOWN_PCT=25
# true = además de las gráficas activadas, corre las estrategias por defecto sobre DESK_SYMBOLS
DESK_AUTO_DEFAULT_STRATEGIES=true

# --- alarmas y avisos --------------------------------------------------------------
# Segundos mínimos entre avisos repetidos de la misma clase
DESK_ALERT_COOLDOWN_SECONDS=300
# Pitido en la consola para avisos y críticos
DESK_ALERT_BELL=true
# Avisar cuando se consuma esta fracción del límite de pérdida diaria (0.8 = 80%)
DESK_DAILY_LOSS_WARN_FRAC=0.8
# Nivel mínimo que se envía a cada canal: info | warn | critical
DESK_ALERT_MIN_LEVEL_TELEGRAM=info
DESK_ALERT_MIN_LEVEL_WEBHOOK=warn
# Bot de Telegram (créalo con @BotFather) y tu chat id; sólo ese chat puede dar órdenes
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook de Discord o Slack para recibir avisos (opcional)
DESK_WEBHOOK_URL=
